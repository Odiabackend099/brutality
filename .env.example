# Legacy (INSECURE - DO NOT USE IN PRODUCTION)
# NEXT_PUBLIC_N8N_WEBHOOK=https://callwaitingai.app.n8n.cloud/webhook/webhook/tts_minimax

# hCaptcha (Attack Protection)
# Make sure these match the Supabase Authentication → Attack Protection settings
# Get keys from https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# LLM Configuration
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# VOICE CONVERSATION SERVICES (REQUIRED FOR VOICE AI)
# =============================================================================

# DEEPGRAM - Speech-to-Text (STT)
# Get from: https://console.deepgram.com → API Keys
# Free tier: $200 in credits
NEXT_PUBLIC_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# GROQ - AI Language Model (LLM)
# Get from: https://console.groq.com → API Keys
# Free tier available
GROQ_API_KEY=gsk_your_groq_api_key_here

# ODIADEV TTS - Text-to-Speech (TTS)
